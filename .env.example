# Kopiere diese Datei zu .env.local und trage die Werte aus deinem Supabase-Projekt ein
# (Dashboard → Project Settings → API). Diese Datei NICHT committen.
#
# Der "anon key" ist bewusst öffentlich lesbar (er landet im App-Bundle) —
# die eigentliche Absicherung passiert über Row-Level-Security in Postgres,
# siehe supabase/schema.sql. Der "service_role key" darf NIEMALS in die App!

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
